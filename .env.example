# --- Server-Side Configuration Secrets ---
# (These keys run on the server only and never ship to the browser)

# Resend API Key for professional email notifications
# Get your key at: https://resend.com
RESEND_API_KEY=""

# The verified sender email address in your Resend account
# Note: Free Resend accounts must use "onboarding@resend.dev"
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Admin email where demo booking leads will be sent
ADMIN_EMAIL="kishorthavamurugan@gmail.com"

# Twilio Credentials for SMS & WhatsApp notifications
# Get these from your Twilio Console dashboard: https://twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Twilio phone number used as the sender for SMS notifications
TWILIO_FROM_NUMBER=""

# Twilio WhatsApp sender (default sandbox number is usually whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM_NUMBER="whatsapp:+14155238886"

# Admin phone number where SMS/WhatsApp lead notifications will be sent
ADMIN_PHONE="+917010584360"

# Gmail SMTP Configuration for sending email notifications
# Note: Google requires a 16-character App Password, not your standard login password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
